# Copy this file to .env and fill in the values. Never commit .env.

# Which AI to use: "openai" (GPT) or "claude". If you leave this out, it uses OpenAI
# when only OPENAI_API_KEY is filled in, and Claude otherwise.
AI_PROVIDER=openai

# For OpenAI (GPT). Get a key at https://platform.openai.com/api-keys
# The model must be able to read images. gpt-4o is more accurate, gpt-4o-mini is cheaper.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# For Claude. Get a key at https://console.anthropic.com
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Optional but recommended. With a SerpAPI key, product pictures come straight from
# Google Images and the AI only writes the name and description. Get a key at https://serpapi.com
# Without it, the app tries to search Bing and open product pages, which often fails.
SERPAPI_KEY=

# Optional. Lets Google Lens find pictures that look like your uploaded photo. Lens can only
# fetch a photo from a public address, so run a tunnel to this app and paste its address here,
# for example: https://something.trycloudflare.com  (see the README, "Google Lens").
PUBLIC_BASE_URL=

# Shopify details are entered in the app, on the Shopify tab, and saved on this computer.
# You can still set them here instead. Details saved in the app win over these.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
