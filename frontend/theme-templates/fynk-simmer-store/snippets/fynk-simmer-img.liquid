{%- comment -%} Image from a picture that ships with the theme (a file name in assets/), a generated URL string or a Shopify image object. Every slot sizes the image in CSS; `width` is the size hint for a picture whose real size is unknown. {%- endcomment -%}
{%- if src != blank -%}
  {%- assign is_url = false -%}
  {%- assign is_asset = false -%}
  {%- if src contains 'fynk-simmer-' -%}{%- assign is_asset = true -%}{%- elsif src contains 'http' or src contains '//' -%}{%- assign is_url = true -%}{%- endif -%}
  {%- if is_asset -%}<img{% if class %} class="{{ class }}"{% endif %} src="{{ src | asset_url }}" alt="{{ alt | escape }}" width="{{ width }}" height="{{ width }}"{% if lazy %} loading="lazy"{% endif %}>{%- elsif is_url -%}<img{% if class %} class="{{ class }}"{% endif %} src="{{ src }}" alt="{{ alt | escape }}" width="{{ width }}" height="{{ width }}"{% if lazy %} loading="lazy"{% endif %}>{%- else -%}<img{% if class %} class="{{ class }}"{% endif %} src="{{ src | image_url: width: width }}" alt="{{ alt | escape }}" width="{{ src.width }}" height="{{ src.height }}"{% if lazy %} loading="lazy"{% endif %}>{%- endif -%}
{%- endif -%}
