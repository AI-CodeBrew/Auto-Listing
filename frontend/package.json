{
  "name": "product-listing-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend of the research-and-review tool that creates Shopify DRAFT products. The backend is ../backend (FastAPI).",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "setup": "playwright install chromium",
    "backend": "cd ../backend && .venv\\Scripts\\python -m uvicorn app:app --host 127.0.0.1 --port 8000",
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build",
    "start": "next start --hostname localhost --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "playwright test"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
