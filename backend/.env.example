# Copy this file to backend/.env and fill in the values. Never commit .env.
# Every key lives here. Only the backend reads it; the frontend needs only BACKEND_URL (frontend/.env).
# Restart the backend after you change it.

# Admin login for /admin. There is no admin sign-up: only these details work.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signs the login cookies. Any long random text. If empty, one is made and kept in backend/data.
AUTH_SECRET=

# Which AI to use: "openai" (GPT) or "claude". If you leave this out, it uses OpenAI
# when only OPENAI_API_KEY is filled in, and Claude otherwise.
AI_PROVIDER=openai

# For OpenAI (GPT). Get a key at https://platform.openai.com/api-keys
# The model must be able to read images. gpt-6-luna is the cheapest current model that can.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# For Claude. Get a key at https://console.anthropic.com
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5

# SerpAPI finds the pictures. Put both free-plan keys here. The app never shows the keys.
# Key 2 is used when you switch to it, or automatically when key 1 has no searches left.
# Restart the app after you change these lines. Get a key at https://serpapi.com
SERPAPI_API_KEY=
SERPAPI_API_KEY_2=

# Used when Video search is turned on. Put the key here. The app does not ask for it on screen.
# Restart the app after you change this line. Get a key at https://developers.fastmoss.com/mcp/overview.html
FASTMOSS_API_KEY=

# Optional. Lets Google Lens find pictures that look like your uploaded photo. Lens can only
# fetch a photo from a public address, so run a tunnel to this app and paste its address here,
# for example: https://something.trycloudflare.com  (see the README, "Google Lens").
PUBLIC_BASE_URL=

# Shopify details are entered in the app, on the Shopify tab, and saved on this computer.
# You can still set them here instead. Details saved in the app win over these.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Or, instead of the client ID and secret: the Admin API access token (starts with shpat_)
# of an app made in the Shopify admin under Develop apps.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10

# Supabase (Postgres): the app's database. With DATABASE_URL filled in, every record (users, plans,
# billing, listings, settings) is saved there, and the tables are created by themselves (schema.sql).
# Use Supabase > Connect > "Transaction pooler" (port 6543) with your database password.
# Leave it empty to use a local SQLite file in backend/data instead. Never commit the filled-in .env.
DATABASE_URL=

# Bunny Storage: where product photos and videos are kept, shown through Bunny's CDN.
# Storage zone > FTP & API Access shows the zone name (Username), the password and the Hostname.
# Leave them empty to keep files on this computer in backend/storage.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_STORAGE_HOST=sg.storage.bunnycdn.com
BUNNY_CDN_URL=

# YouTube Data API v3. Used by Find Creatives. The key stays on the server.
# Restart the app after you change this line. Get a key at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Meta Ad Library (Facebook and Instagram ads). Free. The values stay on the server.
# Restart the app after you change these lines.
# Create an app at https://developers.facebook.com and generate a user token that can read the Ad Library.
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
